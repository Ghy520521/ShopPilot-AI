# ---- 应用 ----
APP_NAME=ShopPilot AI
ENV=dev
DEBUG=true

# ---- 数据库（本地测试默认 sqlite，Docker 部署使用 postgres）----
DATABASE_URL=sqlite:///./shoppilot.db
# DATABASE_URL=postgresql+psycopg2://shoppilot:shoppilot@postgres:5432/shoppilot

# ---- JWT ----
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---- Redis（留空则自动降级为进程内缓存，便于本地无依赖跑测试）----
REDIS_URL=
# REDIS_URL=redis://redis:6379/0

# ---- Celery ----
CELERY_BROKER_URL=
# CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=

# ---- LLM / Embedding（留空使用内置规则解析与本地哈希向量，仅用于开发与测试）----
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# ---- 检索参数 ----
SEARCH_RECALL_K=20
SEARCH_RERANK_K=10
